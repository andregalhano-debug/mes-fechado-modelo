# Copie para .env.local (no seu computador) e cadastre as mesmas na Vercel
# (Settings → Environment Variables). NUNCA coloque valores reais neste arquivo nem no GitHub.

# ---- Seu sistema (nome e identidade) ----
NEXT_PUBLIC_NOME_SISTEMA=Meu Mês Fechado
NEXT_PUBLIC_ASSINATURA=controle financeiro
NEXT_PUBLIC_DESCRICAO=As finanças da casa, organizadas num só lugar.
# Nome da visão "todos juntos" no menu (ex.: Casa, Família, Nós)
NEXT_PUBLIC_ROTULO_CASA=Casa

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: só no servidor. Nunca no WhatsApp, nunca no GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# ---- IA que lê faturas e prints (console.anthropic.com, com limite de gasto) ----
ANTHROPIC_API_KEY=
# Assistente (opcional): modelo e limite de perguntas por pessoa por dia
ASSISTENTE_MODELO=claude-haiku-4-5
ASSISTENTE_LIMITE_DIARIO=40

# ---- Rotinas diárias da Vercel (invente uma frase longa e aleatória) ----
CRON_SECRET=

# ---- Faturas pelo e-mail (opcional; use um Gmail SÓ para faturas) ----
FATURAS_GMAIL_USUARIO=
# Senha de app do Google (exige verificação em duas etapas na conta)
FATURAS_GMAIL_SENHA_APP=
# Domínios de banco aceitos, separados por vírgula (vazio = lista padrão dos principais bancos)
FATURAS_REMETENTES=
# E-mails pessoais que podem encaminhar faturas, separados por vírgula
FATURAS_ENCAMINHADORES=
# De quem é a fatura que chega de cada e-mail: "pessoa@exemplo.com=Ana,outra@exemplo.com=Bruno"
FATURAS_DONOS=
FATURAS_MEMBRO_ID=

# ---- PDFs de fatura com senha (opcional) ----
# CPFs (só números) e datas de nascimento (DDMMAAAA) usados para abrir o PDF, separados por vírgula
FATURAS_PDF_CPFS=
FATURAS_PDF_NASCIMENTOS=
# Outras senhas fixas, separadas por vírgula
FATURAS_PDF_SENHAS=

# ---- Opcional: assinaturas viram contas a pagar (lembrete) ----
NEXT_PUBLIC_ASSINATURAS_VIRAM_CONTAS=0
